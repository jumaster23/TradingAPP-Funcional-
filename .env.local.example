# ═════════════════════════════════════════════════════════════════════════════
# .env.example — Plantilla de variables de entorno
# Copia como: .env.local (desarrollo) o .env (producción)
# ═════════════════════════════════════════════════════════════════════════════

# ─── REQUERIDO ────────────────────────────────────────────────────────────────

# OpenRouter API key para análisis IA/LLM
# Obtén GRATIS en: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# ─── OPCIONAL ─────────────────────────────────────────────────────────────────

# Modelos LLM fallback (separados por coma) para cuando fallan los primarios
# VITE_OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,google/gemma-3-27b-it:free

# Credenciales Alpaca (si no se definen, usa Yahoo Finance como fallback)
# Regístrate gratis: https://alpaca.markets
# VITE_ALPACA_API_KEY=
# VITE_ALPACA_SECRET_KEY=

# Habilitar Service Worker (recomendado: false en despliegues por zip/producción)
VITE_ENABLE_SW=false

# Activar scanners LLM en módulo Swing (por defecto: false)
# VITE_SWING_USE_LLM_SCANNERS=false

# ─── RUNTIME (se configura automáticamente)  ──────────────────────────────────

# Entorno de ejecución (development, production, etc.)
# NODE_ENV=production

# Puerto del servidor (Render/Vercel/localhost)
# PORT=4173
